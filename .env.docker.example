# Variables opcionales para docker compose
# Copiar a .env en la raíz: cp .env.docker.example .env

JWT_SECRET=dev-secret-cambiar-en-produccion

# Activar true para probar compensación Saga (fallo al confirmar ticket)
SIMULATE_CONFIRM_ERROR=false

# Si los puertos 3000-3002 están ocupados (pnpm dev local), usar alternativos:
# COORDINADOR_HOST_PORT=3100
# GESTION_TICKETS_HOST_PORT=3101
# ASIGNACION_HOST_PORT=3102
