{
  "name": "sistema-tickets",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de tickets SOA — NestJS + Next.js",
  "scripts": {
    "build:shared": "pnpm --filter @sistema-tickets/shared-types build",
    "build": "pnpm build:shared && pnpm -r --filter './apps/*' build",
    "dev:tickets": "pnpm --filter @sistema-tickets/gestion-tickets dev",
    "dev:asignacion": "pnpm --filter @sistema-tickets/asignacion-tecnicos dev",
    "dev:coordinador": "pnpm --filter @sistema-tickets/coordinador-solicitudes dev",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps"
  },
  "engines": {
    "node": ">=20"
  }
}
